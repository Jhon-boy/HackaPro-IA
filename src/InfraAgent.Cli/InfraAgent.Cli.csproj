<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>InfraAgent.Cli</RootNamespace>
    <!-- Secretos locales: dotnet user-secrets (nunca en el repositorio). -->
    <UserSecretsId>infraagent-local-dev</UserSecretsId>
  </PropertyGroup>

  <Import Project="..\..\build\InfraAgentContent.props" />

  <ItemGroup>
    <ProjectReference Include="..\InfraAgent.Infrastructure\InfraAgent.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.14" />
  </ItemGroup>

</Project>
